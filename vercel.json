{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/cron/warmup",
      "schedule": "*/4 * * * *"
    },
    {
      "path": "/api/cron/process-duplications",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/enrollments-expiry",
      "schedule": "0 * * * *"
    }
  ]
}
